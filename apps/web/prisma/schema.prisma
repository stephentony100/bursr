// Bursr data model. Money is stored as integer strings in smallest units;
// structured fields are JSON text validated with zod on every read.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// The one business this install runs for.
model Business {
  id             String   @id @default("main")
  name           String
  /// The NEAR account that owns it; one business per wallet for now.
  ownerAccountId String
  /// Rules (lib/domain.ts RulesSchema) as JSON.
  rules          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerAccountId])
}

model Payee {
  id              String    @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId      String    @default("main")
  name            String
  category        String
  /// Payout (token, address, memo) as JSON. Only the owner changes it.
  payout          String
  /// PriceItem[] as JSON.
  prices          String    @default("[]")
  /// { amountUsd, every } | null as JSON.
  recurring       String    @default("null")
  addedAt         DateTime  @default(now())
  /// Set when the owner changes payout details; starts the 48h hold.
  payoutChangedAt DateTime?
  /// When the owner first approved a payment to them; until then each payment needs the owner.
  trustedAt       DateTime?
  /// A one-time payee: taken off the list automatically once their payment arrives.
  removeAfterPaid Boolean   @default(false)
  removedAt       DateTime?

  @@index([businessId])
}

/// The agent's account and the policy the owner last signed.
model AgentAccount {
  id              String    @id @default("main")
  backend         String
  /// Agent API agent id (live) or "dry-run".
  agentId         String
  /// The policy currently in force, as JSON (Agent API Policy type).
  policy          String
  policyRevision  Int       @default(0)
  /// When the weekly cap was turned on; its 7-day periods count from here.
  budgetStartedAt DateTime  @default(now())
  /// Dry-run only: simulated balances per asset id, as JSON { assetId: "amount" }.
  simBalances     String    @default("{}")
  /// Live only: the agent's grant (payment pass), sealed with BURSAR_DATA_KEY (lib/grant-store.ts). Never plain text.
  grantSealed     String?
  grantExpiresAt  DateTime?
  signedAt        DateTime  @default(now())
}

/// Every money action the agent asked the account for, allowed or refused.
model AccountAction {
  id             String   @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId     String   @default("main")
  idempotencyKey String   @unique
  at             DateTime @default(now())
  kind           String
  /// The request as JSON (amounts as strings).
  request        String
  outcome        String
  code           String?
  message        String?
  usdMicros      String   @default("0")
  /// Live: Agent API correlation id.
  correlationId  String?

  @@index([businessId])
}

/// An invoice as received, what the Reader read, and what the checks decided.
model Invoice {
  id            String   @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId    String   @default("main")
  receivedAt    DateTime @default(now())
  fileName      String
  mediaType     String
  fileHash      String
  file          Bytes
  /// Who read it: "NEAR AI Cloud, <model>" or the practice-mode note.
  readBy        String
  chatId        String?
  /// ExtractedInvoice as JSON, or null when it could not be read.
  extracted     String?
  supplierName  String   @default("")
  invoiceNumber String   @default("")
  totalUsd      String   @default("0")
  payeeId       String?
  /// ready | flag | defer | hold | block | needs_owner
  status        String
  /// CheckResult[] as JSON
  results       String   @default("[]")
  /// Why it needs the owner (unreadable, unsure fields, other currency).
  needsOwner    String?

  @@index([businessId])
}

/// One week's payment plan. The owner approves it as a whole.
model Plan {
  id         String     @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId String     @default("main")
  createdAt  DateTime   @default(now())
  /// draft | approved | done
  status     String     @default("draft")
  approvedAt DateTime?
  approvedBy String?
  /// USD left under the weekly limit when the plan was built (6 decimals)
  capLeftUsd String
  items      PlanItem[]

  @@index([businessId])
}

model PlanItem {
  id             String    @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId     String    @default("main")
  planId         String
  plan           Plan      @relation(fields: [planId], references: [id])
  /// invoice | wages
  kind           String
  invoiceId      String?
  payeeId        String
  payeeName      String
  /// What it is for, in plain words ("Invoice #MPF-0412", "Weekly pay")
  forWhat        String
  amountUsd      String
  /// The payout exactly as it was when planned (token, address, memo) as JSON
  payout         String
  /// in | held | deferred | removed
  placement      String
  reason         String?
  /// Needs the owner's own tap before paying (above threshold or new payee)
  needsOwnTap    Boolean   @default(false)
  ownTapReason   String?
  ownTapAt       DateTime?
  /// Dry quote: { amountIn, amountOut, withdrawFee, timeEstimate, at } as JSON
  quote          String?
  /// Why there is no quote (1Click unreachable, refused the pair, …)
  quoteError     String?
  /// planned | paying | sent | delivered | failed | refunded
  payStatus      String    @default("planned")
  payReason      String?
  sentAt         DateTime?
  /// What was sent from the account (treasury token) and received by the payee (payee token), smallest units
  amountSent     String?
  amountReceived String?
  /// The network fee the business paid on top so the payee received the full amount (payee token units)
  networkFee     String?
  /// Account correlation ids (swap, withdraw) as JSON
  references     String    @default("[]")
  /// What this payment is for, so the agent never schedules it twice: "<payeeId>@<due date>" or "inv:<invoiceId>".
  dueKey         String?
  /// The day it is due (YYYY-MM-DD, business time zone).
  dueOn          String?
  /// Self-repair: tries so far, the next try, and the last refusal code.
  attempts       Int       @default(0)
  retryAt        DateTime?
  payCode        String?

  @@index([businessId])
}

/// Small key/value settings (Telegram link, bot name).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Telegram messages already sent, by key, so each alert goes out once.
model TelegramMessage {
  key        String   @id
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId String   @default("main")
  sentAt     DateTime @default(now())

  @@index([businessId])
}

/// Every refusal, rule change and payment attempt, in order. Never edited.
model AuditEvent {
  id         String   @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId String   @default("main")
  at         DateTime @default(now())
  kind       String
  actor      String
  message    String
  data       String?

  @@index([businessId])
}

/// A link the owner sends to someone they will pay, so that person enters how
/// they want to be paid. What they send waits for the owner's OK; only then are
/// they added to the payee list (and, live, signed into the account's policy).
model PayeeInvite {
  id          String    @id @default(cuid())
  /// The business this belongs to (every query is limited to one business: lib/tenant.ts).
  businessId  String    @default("main")
  /// Random, unguessable; the only key in the link.
  token       String    @unique
  name        String
  category    String
  /// Regular pay set by the owner (JSON, same shape as Payee.recurring), or "null".
  recurring   String    @default("null")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  /// What they sent (JSON payout), when.
  payout      String?
  submittedAt DateTime?
  /// open | submitted | approved | declined
  status      String    @default("open")
  /// "Pay someone once": the payment to make when the owner approves their details (JSON { amountUsd, note }).
  oneOff      String?
  payeeId     String?
  /// A group link: one link for many people (each types their own name); it stays open until it expires.
  group       Boolean   @default(false)
  /// For a person who answered a group link: the group link's id.
  groupId     String?

  @@index([businessId])
}
