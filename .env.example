# --- Mode ---
# dry-run (default): sample data, real dry 1Click quotes, simulated payments, no keys needed
# live: real payments on mainnet (only with the human's OK, tiny amounts)
BURSAR_MODE=dry-run

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
# Signs the owner's session cookie in live mode. Any long random string; if empty, sessions end when the server restarts.
BURSAR_SESSION_SECRET=

# --- NEAR ---
# The Agent API and NEAR Intents exist only on mainnet (no testnet), so the owner signs in with a mainnet account.
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org

# --- Agent account (decided in M0: Agent API; see docs/DECISIONS.md) ---
# Live mode only. Dry-run checks the same rules with a local simulator.
# The Agent API runs on NEAR mainnet (demo and production alike).
AGENT_ACCOUNT_BACKEND=agent-api

# Agent API: partner key (naa_...), the agent's id, and the agent's grant token (ngt_...)
AGENT_API_BASE_URL=https://api.demo.agentsonintents.com
AGENT_API_KEY=
AGENT_API_AGENT_ID=
AGENT_API_GRANT_TOKEN=

# Fallback vault (not built unless the Agent API cannot be used)
VAULT_CONTRACT_ID=
AGENT_ACCOUNT_ID=
AGENT_FUNCTION_CALL_PRIVATE_KEY=

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
ONECLICK_SLIPPAGE_BPS=100
BURSAR_FEE_ACCOUNT_ID=
BURSAR_FEE_BPS=0

# --- NEAR AI Cloud ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# --- Telegram (P1, optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
