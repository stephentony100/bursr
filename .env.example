# --- Mode ---
# dry-run (default): sample data, real dry 1Click quotes, simulated payments, no keys needed
# live: real payments on mainnet (only with the human's OK, tiny amounts)
BURSAR_MODE=dry-run
# Bursar's agent works in the background while the app runs (pays what is due, retries, reports). "off" stops it.
BURSAR_AGENT=on
# Terminal scripts only (fund, live-preview, rules-live), when this Bursar holds several businesses:
# the owner's NEAR account of the business to work on.
BURSAR_OWNER=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
# Signs the owner's session cookie in live mode. Any long random string; if empty, sessions end when the server restarts.
BURSAR_SESSION_SECRET=

# --- NEAR ---
# The Agent API and NEAR Intents exist only on mainnet (no testnet), so the owner signs in with a mainnet account.
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org

# --- Agent account (decided in M0: Agent API; see docs/DECISIONS.md) ---
# Live mode only. Dry-run checks the same rules with a local simulator.
# The Agent API runs on NEAR mainnet (demo and production alike).
AGENT_ACCOUNT_BACKEND=agent-api

# Agent API: the partner key from the Partner Dashboard. The agent and its
# payment pass are created in the app (Spending rules) and kept in the database.
AGENT_API_BASE_URL=https://api.demo.agentsonintents.com
AGENT_API_KEY=
# Optional check: if set, must match the business's agent.
AGENT_API_AGENT_ID=
# Live only: 64 hex characters that seal the agent's payment pass in the database.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it only means pressing "Let Bursar make payments" again.
BURSAR_DATA_KEY=

# Fallback vault (not built unless the Agent API cannot be used)
VAULT_CONTRACT_ID=
AGENT_ACCOUNT_ID=
AGENT_FUNCTION_CALL_PRIVATE_KEY=

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
ONECLICK_SLIPPAGE_BPS=100
# Bursar's fee per plan, in basis points (50 = 0.5%), paid like a payee to an address on the owner's signed list.
# Practice mode uses a made-up fee account; live mode needs BURSAR_FEE_ACCOUNT_ID (NEAR account receiving USDC) or there is no fee.
BURSAR_FEE_ACCOUNT_ID=
BURSAR_FEE_BPS=50

# --- NEAR AI Cloud ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# The agent you chat with (must support tools). Empty: Qwen/Qwen3.6-35B-A3B-FP8 (TEE, verifiable).
NEAR_AI_CHAT_MODEL=

# --- Telegram (optional) ---
# Token from @BotFather. Run `npm run bot`, then link your chat on Rules & account → Connect Telegram.
TELEGRAM_BOT_TOKEN=
