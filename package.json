{
  "name": "bursar",
  "version": "0.1.0",
  "private": true,
  "description": "An AI that pays a small business's bills inside rules the owner sets.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test -w apps/web",
    "lint": "npm run lint -w apps/web",
    "demo": "npm run demo -w apps/web",
    "smoke:oneclick": "npm run smoke:oneclick -w apps/web",
    "smoke:nearai": "npm run smoke:nearai -w apps/web",
    "smoke:agent-api": "npm run smoke:agent-api -w apps/web",
    "rules:live": "npm run rules:live -w apps/web",
    "db:push": "npm run db:push -w apps/web",
    "readings:record": "npm run readings:record -w apps/web",
    "live:preview": "npm run live:preview -w apps/web",
    "fund": "npm run fund -w apps/web --"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true
  }
}
